{
  "name": "@pramaan/web",
  "private": true,
  "version": "0.1.0",
  "description": "Pramaan examiner UI — Vite + React + TS. See docs/04-FRONTEND.md.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "build:mock-preview": "vite build --mode mock --outDir dist-mock && vite preview --outDir dist-mock --port 4173 --strictPort",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.gen.ts",
    "shots": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.71.5",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.6.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.1.0",
    "zustand": "^5.0.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "^25.0.1",
    "msw": "^2.7.3",
    "openapi-typescript": "^7.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
